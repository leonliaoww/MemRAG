# ── 阿里云 DashScope（必填）─────────────────
DASHSCOPE_API_KEY=YOUR-ALIYUN-DASHSCOPE-API-KEY

# ── 应用配置 ─────────────────────────────────
APP_NAME="RAG Enterprise"
DEBUG=false
LOG_LEVEL=INFO

# ── 服务器 ───────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Chroma 向量库（本地持久化）───────────────
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=rag_documents

# ── 文档处理 ─────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_MB=50

# ── 检索 ─────────────────────────────────────
RETRIEVAL_TOP_K=5
HYBRID_SEARCH_ENABLED=true
RERANK_ENABLED=true
# 重排序模型：设了 RERANK_MODEL_PATH 就用本地离线加载，不设则从 HuggingFace 自动下载
# 下载命令：git clone https://huggingface.co/cross-encoder/ms-marco-MiniLM-L-6-v2 ./models/reranker/ms-marco-MiniLM-L-6-v2
RERANK_MODEL_PATH=./models/reranker/ms-marco-MiniLM-L-6-v2

# ── 模型配置 ─────────────────────────────────
# LLM 供应商：dashscope | openai（切换后自动使用对应适配器）
LLM_PROVIDER=dashscope
# DashScope 模型
DASHSCOPE_LLM_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
# OpenAI 模型（LLM_PROVIDER=openai 时使用）
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 生成参数
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# ── 认证（生产环境务必修改）──────────────────
AUTH_ENABLED=false
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
